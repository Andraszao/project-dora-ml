<Project>
  <!-- Shared by every project under dora-bio/, including the Godot project. -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DORA's version (Pipeline.Version): the SDK appends the git commit, so outputs and models name their build. -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix>bio</VersionSuffix>
  </PropertyGroup>
</Project>
