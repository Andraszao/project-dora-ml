; Engine configuration file.
; Godot 4.5 **.NET** edition is required (this project has C# scripts).

config_version=5

[application]

config/name="Project DORA v2 (bio)"
config/description="Self-supervised fluorescence microscopy denoising. ML core: DoraBio.Core (C#, ../src)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[dotnet]

project/assembly_name="DoraBio.Godot"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
