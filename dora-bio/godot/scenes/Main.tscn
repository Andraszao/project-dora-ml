folder_dialog = NodePath("FolderDialog")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.07, 0.08, 0.1, 1)

[node name="DoraBioBridge" type="Node" parent="."]
script = ExtResource("2_bridge")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "PROJECT: DORA v2 · bio"

[node name="ModelLabel" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.65, 0.7, 0.78, 1)
text = "loading model"
horizontal_alignment = 2
vertical_alignment = 1
text_overrun_behavior = 3

[node name="Subtitle" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.7, 0.78, 1)
text = "Self-supervised fluorescence denoising. Raw vs. classical filter vs. DORA, on one shared 32-bit display window."

[node name="Panels" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="RawPanel" type="VBoxContainer" parent="Margin/Layout/Panels"]
layout_mode = 2
size_flags_horizontal = 3

[node name="RawCaption" type="Label" parent="Margin/Layout/Panels/RawPanel"]
layout_mode = 2
text = "Raw"
text_overrun_behavior = 3

[node name="RawView" type="TextureRect" parent="Margin/Layout/Panels/RawPanel"]
