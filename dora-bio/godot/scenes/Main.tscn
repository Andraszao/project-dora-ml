scroll_following = true
selection_enabled = true

[node name="FileDialog" type="FileDialog" parent="."]
title = "Open a microscopy image"
size = Vector2i(900, 600)
ok_button_text = "Open"
file_mode = 0
access = 2
filters = PackedStringArray("*.tif, *.tiff ; TIFF images", "*.png ; PNG images")

[node name="FolderDialog" type="FileDialog" parent="."]
title = "Choose a training folder"
size = Vector2i(900, 600)
