[node name="Sep1" type="VSeparator" parent="Margin/Layout/Toolbar"]
layout_mode = 2

[node name="DenoiseButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
text = "Denoise"

[node name="AdaptButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
tooltip_text = "Self-supervised Noise2Void fine-tuning on the loaded image. No ground truth needed."
text = "Adapt to sample"

[node name="AdaptSteps" type="SpinBox" parent="Margin/Layout/Toolbar"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
min_value = 1.0
max_value = 500.0
value = 20.0
suffix = "steps"
alignment = 2

[node name="Sep2" type="VSeparator" parent="Margin/Layout/Toolbar"]
layout_mode = 2

[node name="TrainSyntheticButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
tooltip_text = "Fine-tune on synthetic fluorescence data generated in memory."
text = "Train (synthetic)"

[node name="TrainFolderButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
tooltip_text = "Folder layouts: noisy/ + clean/, FMD raw/ + gt/, or flat TIFF/PNG files (Noise2Void)."
text = "Train on folder…"

[node name="Epochs" type="SpinBox" parent="Margin/Layout/Toolbar"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
min_value = 1.0
max_value = 200.0
value = 5.0
suffix = "epochs"
alignment = 2

[node name="Spacer" type="Control" parent="Margin/Layout/Toolbar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CancelButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
text = "Cancel"

[node name="SaveButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
