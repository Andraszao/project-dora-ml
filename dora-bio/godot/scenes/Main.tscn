[node name="Main" type="Control" node_paths=PackedStringArray("bridge", "raw_view", "baseline_view", "dora_view", "raw_caption", "baseline_caption", "dora_caption", "model_label", "status_label", "log_view", "load_sample_button", "open_button", "denoise_button", "adapt_button", "adapt_steps", "train_synthetic_button", "train_folder_button", "epochs_box", "cancel_button", "save_button", "gamma_slider", "file_dialog", "folder_dialog")]
