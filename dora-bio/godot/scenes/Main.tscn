custom_minimum_size = Vector2(240, 240)
layout_mode = 2
size_flags_vertical = 3
expand_mode = 1
stretch_mode = 5

[node name="BaselinePanel" type="VBoxContainer" parent="Margin/Layout/Panels"]
layout_mode = 2
