[node name="Toolbar" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="LoadSampleButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
text = "Load sample"

[node name="OpenButton" type="Button" parent="Margin/Layout/Toolbar"]
layout_mode = 2
