min_value = 0.2
max_value = 3.0
step = 0.05
value = 1.0

[node name="StatusLabel" type="Label" parent="Margin/Layout/DisplayRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Ready"
horizontal_alignment = 2

[node name="LogView" type="RichTextLabel" parent="Margin/Layout"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
